# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files with secrets (keep .example files)
*.tfvars
*.tfvars.json
*.auto.tfvars
*.auto.tfvars.json
!*.example.tfvars
!*.tfvars.example
!terraform.tfvars.example

# Ignore override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration files
.terraformrc
terraform.rc
