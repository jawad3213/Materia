# ==========================================
# Root & System
# ==========================================
.DS_Store
Thumbs.db
*.log
.vscode/
.idea/
**/.idea/
specs/

# ==========================================
# Root Environment Secrets
# ==========================================
.env
.env.local

# Backend ignored resources
# Flyway migrations are tracked: every environment needs them to build its schema.
# The users migration seeds default accounts with password hashes; it stays local until
# those accounts are created another way.
backend/src/main/resources/db/migration/V20260922_01__create_users_table.sql
backend/src/main/resources/META-INF/

# ==========================================
# Terraform & Infrastructure Secrets
# ==========================================
**/.terraform/
*.tfstate
*.tfstate.*
*.tfstate.backup
crash.log
crash.*.log
*.tfvars
*.tfvars.json
*.auto.tfvars
*.auto.tfvars.json
!*.example.tfvars
!*.tfvars.example
!terraform.tfvars.example
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc
# Saved plans contain every value, secrets included
*.tfplan
*.tfplan.json
tfplan
# Account-specific backend settings (backend.hcl.example is tracked)
backend.hcl
*.backend.hcl
# Local copies of the deploy environment (written on the host from Parameter Store)
aws/deploy/.env
aws/deploy/.env.*
# .terraform.lock.hcl stays tracked so every run uses the same provider versions


